{
  "name": "tonecos-catalogo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "brand:source": "python -m unittest -q tools.test_brand_identity",
    "test:known-cache": "node --experimental-strip-types --test tools/test_known_model_cache.mjs",
    "brand:dist": "node tools/check_generated_brand.mjs",
    "budget:frontend": "node tools/check_frontend_budget.mjs",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "check": "npm run brand:source && npm run test:known-cache && npm run test:wrangler-config && npm run test:cloudflare-deploy-state && npm run test:worker-release-smoke && npm run test:promoted-worker && npm run test:remote-worker-config && npm run test:gallery-runtime && npm run test:worker-gallery-contract && npm run test:worker-folder-counts && npm run test:worker-search-contract && npm run test:worker-schema-contract && npm run test:worker-health-contract && npm run test:model-aliases && npm run test:public-gallery-revision && npm run test:legacy-gallery-grouping && npm run test:legacy-gallery-repairs-contract && npm run test:catalog-home && npm run test:gallery-grid && npm run dialog:a11y && npm run build && npm run brand:dist && npm run budget:frontend && npm run typecheck:worker",
    "cloudflare:config": "node tools/render_wrangler_config.mjs",
    "preview": "vite preview",
    "dialog:a11y": "node tools/check_dialog_architecture.mjs",
    "test:wrangler-config": "node --test tools/test_wrangler_config_contract.mjs",
    "test:cloudflare-deploy-state": "node --test tools/test_cloudflare_deploy_state.mjs",
    "test:worker-release-smoke": "node --test tools/test_worker_release_smoke.mjs",
    "test:promoted-worker": "node --test tools/test_promoted_worker_version.mjs",
    "test:remote-worker-config": "node --test tools/test_remote_worker_config.mjs",
    "test:gallery-runtime": "node --experimental-strip-types --test tools/test_gallery_validation.mjs tools/test_gallery_aggregation.mjs",
    "test:worker-gallery-contract": "node --test tools/test_worker_gallery_contract.mjs",
    "test:catalog-home": "node --experimental-strip-types --test tools/test_catalog_home_view.mjs",
    "test:gallery-grid": "node --experimental-strip-types --test tools/test_gallery_grid_navigation.mjs",
    "test:worker-folder-counts": "node --test tools/test_worker_folder_counts.mjs",
    "test:legacy-gallery-grouping": "node --experimental-strip-types --test tools/test_legacy_gallery_grouping.mjs",
    "test:worker-schema-contract": "node --experimental-strip-types --test tools/test_schema_contract.mjs",
    "test:worker-health-contract": "node --test tools/test_worker_health_contract.mjs",
    "test:model-aliases": "node --experimental-strip-types --test tools/test_model_aliases.mjs",
    "test:public-gallery-revision": "node --test tools/test_public_gallery_revision.mjs",
    "test:legacy-gallery-repairs-contract": "node --test tools/test_legacy_gallery_repairs_contract.mjs",
    "test:worker-search-contract": "node --test tools/test_worker_search_contract.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "wrangler": "4.149.0"
  }
}
