# Deixe vazio para usar o modo demonstração local.
# Depois do deploy do Worker Cloudflare, informe a origem pública canônica sem barra final.
# A mesma origem serve /api/* e /media/*; o bucket R2 permanece privado atrás do Worker.
VITE_API_BASE_URL=

# Chave PUBLICA do widget Cloudflare Turnstile usada pelo formulário de orçamento.
# O secret correspondente nunca deve entrar neste arquivo nem no frontend.
VITE_TURNSTILE_SITE_KEY=
